{
  // Static site only: the Flutter web build is served as-is, no Worker script.
  "name": "tawla-web",
  "compatibility_date": "2026-10-10",
  // The staff site (admin and cashier). staff.tawla.ly is its own address; tawla.ly stays for now
  // so existing links keep working, but its "/" is the public sales page (see guest-web/wrangler.jsonc).
  // Cloudflare creates the DNS record and certificate on deploy. To hide the staff site from
  // tawla.ly completely, follow docs/STAFF_DOMAIN_CUTOVER.md.
  "routes": [
    { "pattern": "staff.tawla.ly", "custom_domain": true },
    { "pattern": "tawla.ly", "custom_domain": true }
  ],
  "assets": {
    "directory": "./build/web",
    // Deep links (e.g. /c/<slug>) get index.html; missing files still return 404.
    "not_found_handling": "single-page-application"
  }
}
