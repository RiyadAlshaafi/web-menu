# Read by the Windows build (tool/build_windows.ps1, --dart-define-from-file=.env)
# and by `flutter run`. The web build (tool/build_web.sh) reads the same two names from
# the environment (GitHub Actions secrets in CI).
SUPABASE_URL=https://your-project.supabase.co
# The project's publishable (or legacy anon) key. Older names still work:
# SUPABASE_PUBLISHABLE_KEY, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY,
# NEXT_PUBLIC_SUPABASE_ANON_KEY - but use this one for new setups.
SUPABASE_ANON_KEY=your-publishable-key
